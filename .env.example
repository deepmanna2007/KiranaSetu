# KiranaSetu Pro - Environment Variables Example
# Copy this file to .env.local and fill in your own values.
# .env.local is in .gitignore and will NEVER be committed to git.

# Google Gemini API Key
# Get a free key at: https://aistudio.google.com/apikey
# NOTE: In this app the key is stored in the user's browser localStorage
# via the Settings tab (Sales & Settings → Gemini AI Configuration).
# You do NOT need a .env file to run this app — this file is for reference only.
VITE_GEMINI_API_KEY=your_gemini_api_key_here
